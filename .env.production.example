# =============================================================================
# DashZen — production template (PaaS)
# =============================================================================
# Vercel (Studio) + Render (API) + Neon (Postgres) + cloud LLM
# Copy secrets into Render / Vercel dashboards — never commit real values.
#
# Source of truth for Render defaults: render.yaml
# See infra/deploy/paas.md for deploy checklist.

# =============================================================================
# Render — API (dashzen-api)
# =============================================================================
# Committed in render.yaml          → safe defaults, no secrets
# sync: false in render.yaml       → set manually in Render dashboard
# Not in render.yaml                → optional overrides in dashboard

# ── Set in render.yaml (defaults) ─────────────────────────────────────────────

APP_ENV=production
PYTHONUNBUFFERED=1
EMAIL_BACKEND=console
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash-lite
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
RATE_LIMIT_ENABLED=true
AVATAR_STORAGE_DIR=/app/data/avatars
GOOGLE_OAUTH_ENABLED=true
GITHUB_OAUTH_ENABLED=true
OAUTH_STATE_TTL_SECONDS=600

# ── Set in Render dashboard (sync: false) ─────────────────────────────────────

# Neon — asyncpg URL; sslmode=require is OK (app strips it for asyncpg)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# openssl rand -hex 32
JWT_SECRET_KEY=

# Public API URL after first deploy (no trailing slash)
API_PUBLIC_URL=https://dashzen-api.onrender.com

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Optional — only if you need explicit CORS (Vercel previews use regex when unset)
# API_CORS_ORIGINS=https://your-studio.vercel.app

# Studio URL for OAuth post-login redirect
STUDIO_PUBLIC_URL=https://your-studio.vercel.app

# Google OAuth — callback via Vercel /api proxy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-studio.vercel.app/api/v1/auth/google/callback
# GOOGLE_HD=

# GitHub OAuth — callback via Vercel /api proxy
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-studio.vercel.app/api/v1/auth/github/callback

# ── Optional Render dashboard overrides ───────────────────────────────────────

JWT_ALGORITHM=HS256

# Email — switch from console to SMTP when ready
# EMAIL_BACKEND=smtp
# EMAIL_FROM=noreply@yourdomain.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_SSL=true
# SMTP_TLS=false

# Alternative LLM — set LLM_PROVIDER and matching keys in dashboard
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_SITE_URL=https://your-studio.vercel.app
# OPENROUTER_APP_NAME=DashZen Studio

# LLM_PROVIDER=vilao
# VILAO_API_KEY=
# VILAO_MODEL=dd/deepseek-v4-pro
# VILAO_BASE_URL=https://api.vilao.ai/v1

# Multi-instance / durable streams & rate limits (recommended beyond free tier)
# REDIS_URL=rediss://default:token@host.upstash.io:6379

# =============================================================================
# Vercel — Studio (apps/studio) — NOT on Render
# =============================================================================

NEXT_PUBLIC_API_URL=/api
API_BACKEND_URL=https://dashzen-api.onrender.com

NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true
