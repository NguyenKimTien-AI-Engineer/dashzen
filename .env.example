# =============================================================================
# DashZen — local development template
# =============================================================================
# Copy to .env and fill in secrets. Never commit .env.
# Studio: copy the "Studio" section to apps/studio/.env.local
# Production: see .env.production.example (Render + Vercel + Neon)

# ── App ──────────────────────────────────────────────────────────────────────

APP_ENV=development

# ── API ──────────────────────────────────────────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
AVATAR_STORAGE_DIR=data/avatars
# API_CORS_ORIGIN_REGEX=

# ── Database ─────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://dashzen:dashzen@localhost:5432/dashzen

# ── Redis ────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0

# ── Object storage (optional — local MinIO) ──────────────────────────────────

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dashzen

# ── Vector store (optional — local Qdrant) ───────────────────────────────────

QDRANT_URL=http://localhost:6333

# ── JWT ──────────────────────────────────────────────────────────────────────

JWT_SECRET_KEY=change-me-jwt-secret-min-16-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# RS256: set JWT_ALGORITHM=RS256 and provide PEM keys instead of JWT_SECRET_KEY
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ── Auth cookies ─────────────────────────────────────────────────────────────

ACCESS_COOKIE_NAME=dashzen_access_token
REFRESH_COOKIE_NAME=dashzen_refresh_token
ACCESS_COOKIE_PATH=/
REFRESH_COOKIE_PATH=/v1/auth
COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# ── Rate limiting ────────────────────────────────────────────────────────────

RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_REGISTER_RATE_LIMIT=10/minute
AUTH_REFRESH_RATE_LIMIT=3/minute
AUTH_VERIFY_RATE_LIMIT=5/minute
AUTH_RESEND_RATE_LIMIT=3/hour

# ── Email ────────────────────────────────────────────────────────────────────
# console = print codes to API logs | smtp = Mailpit (infra/compose) on :1025

EMAIL_BACKEND=console
EMAIL_FROM=noreply@dashzen.local
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false

# ── LLM ──────────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to one of: ollama | anthropic | openai | gemini | openrouter | vilao

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=
# OLLAMA_THINKING_ENABLED=true

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=DashZen Studio

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-5-20251101

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# VILAO_API_KEY=
# VILAO_MODEL=dd/deepseek-v4-pro
# VILAO_BASE_URL=https://api.vilao.ai/v1

# ── OAuth (API — Render/local) ───────────────────────────────────────────────

STUDIO_PUBLIC_URL=http://localhost:3000
OAUTH_STATE_TTL_SECONDS=600

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
# GOOGLE_HD=

GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# ── Studio (apps/studio/.env.local) ──────────────────────────────────────────
# Direct API in local dev — no Vercel proxy.

NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
# NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true
